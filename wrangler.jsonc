{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ddns-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "keep_vars": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "ENVIRONMENT": "production", "APP_HOST": "ddns.example.com", "ALLOW_PRIVATE_IPS": "false", "ENABLE_UNIFI_COMPAT": "true", "DETAILED_ERRORS": "false" },
  "d1_databases": [{ "binding": "DDNS_DB", "migrations_dir": "migrations" }]
}
