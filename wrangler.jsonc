{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ddns-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "keep_vars": true,
  "secrets": {
    "required": [
      "CLOUDFLARE_DNS_API_TOKEN",
      "ACCESS_TEAM_DOMAIN",
      "ACCESS_AUD"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [{ "binding": "DDNS_DB", "migrations_dir": "migrations" }]
}
