{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ddns-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "keep_vars": true,
  "ratelimits": [
    { "name": "DDNS_PREAUTH_RATE_LIMITER", "namespace_id": "90960801", "simple": { "limit": 60, "period": 60 } },
    { "name": "DDNS_CLIENT_RATE_LIMITER", "namespace_id": "90960802", "simple": { "limit": 10, "period": 60 } },
    { "name": "ADMIN_RATE_LIMITER", "namespace_id": "90960803", "simple": { "limit": 60, "period": 60 } }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "secrets": {
    "required": [
      "CLOUDFLARE_DNS_API_TOKEN",
      "ACCESS_TEAM_DOMAIN",
      "ACCESS_AUD"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [{ "binding": "DDNS_DB", "migrations_dir": "migrations" }]
}
